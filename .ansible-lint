---
# .ansible-lint configuration pour EpiceaInfra

profile: production

exclude_paths:
  - .github/
  - scripts/
  - "*.md"
  - "*.py"
  - "*.txt"
  - "inventory/"
  - ".venv/"
  # Chiffré : ce n'est pas du YAML lisible
  - ansible/secrets/vault.yml

# Le syntax-check lancé par ansible-lint ne peut pas déchiffrer le vault : il lit le modèle
extra_vars:
  epicea_vault_file: ../secrets/vault.yml.example

skip_list:
  - role-name
  - meta-no-info
  - meta-incorrect
  - layout
  - no-handler
  - var-naming[no-role-prefix]

warn_list:
  - no-changed-when
  - command-instead-of-module
  - risky-shell-pipe
  - partial-become
  - fqcn-builtins
