---
# .ansible-lint configuration pour EpiceaInfra

profile: production

exclude_paths:
  - .github/
  - scripts/
  - "*.md"
  - "*.py"
  - "*.txt"
  - "inventory/"
  - ".venv/"

skip_list:
  - role-name
  - meta-no-info
  - meta-incorrect
  - layout
  - no-handler
  - var-naming[no-role-prefix]

warn_list:
  - no-changed-when
  - command-instead-of-module
  - risky-shell-pipe
  - partial-become
  - fqcn-builtins
