---
# ========================================
# Secrets - modèle de ansible/secrets/vault.yml
# ========================================
# Contient exactement les clés lues par le code.
# Créer et chiffrer : make init    Éditer : make secrets

# ---------- Traefik ----------
# Accès au dashboard, au format htpasswd : htpasswd -nb admin <mot-de-passe>
traefik_auth: "admin:$apr1$CHANGE_ME"

# ---------- Redis (partagé) ----------
redis_password: "ChangeMe_Redis"

# ---------- Immich ----------
immich_db_username: "immich"
immich_db_password: "ChangeMe_ImmichDB"
immich_db_database: "immich"

# ---------- Nextcloud ----------
nextcloud_admin_user: "admin"
nextcloud_admin_password: "ChangeMe_NextcloudAdmin"
nextcloud_db_user: "nextcloud"
nextcloud_db_password: "ChangeMe_NextcloudDB"
nextcloud_db_database: "nextcloud"

# ---------- Grafana ----------
grafana_admin_user: "admin"
grafana_admin_password: "ChangeMe_Grafana"

# ---------- GHCR ----------
# Images privées Litopia et Backpaking : token GitHub avec le droit read:packages
ghcr_username: ""
ghcr_token: ""

# ---------- Litopia ----------
litopia_db_user: "litopia"
litopia_db_password: "ChangeMe_LitopiaDB"
litopia_db_database: "litopia"
litopia_api_local_key: "ChangeMe"
litopia_amp_host: ""
litopia_amp_instance: ""
litopia_amp_login: ""
litopia_discord_client_id: ""
litopia_discord_client_secret: ""
litopia_discord_client_token: ""
litopia_discord_callback_url: ""
litopia_discord_guild_id: ""
litopia_discord_candidature_channel_id: ""
litopia_discord_role_ghost: ""
litopia_discord_role_candidate: ""
litopia_discord_role_pre_accepted: ""
litopia_discord_role_pretopien: ""
litopia_discord_role_litopien: ""
litopia_discord_role_active_litopien: ""
litopia_discord_role_inactive_litopien: ""
litopia_discord_role_refused: ""
litopia_discord_role_litogod: ""
litopia_discord_role_unique_god: ""

# ---------- Backpaking ----------
backpaking_db_user: "backpaking"
backpaking_db_password: "ChangeMe_BackpakingDB"
backpaking_db_database: "backpaking"
backpaking_jwt_secret: "ChangeMe"
backpaking_map_token: ""
backpaking_weather_api_key: ""

# ---------- Alertes ----------
# Webhook Discord des alertes et du rapport de démarrage (vide : pas de notification)
discord_webhook_url: ""
