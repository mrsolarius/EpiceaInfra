# ========================================
# Configuration dynamique Traefik - Générée par Ansible
# ========================================
# Le port 80 redirige déjà tout vers HTTPS (traefik.yml) : seuls les routeurs
# HTTPS sont nécessaires. Les middlewares des applications sont dans leurs labels.

http:
  middlewares:
    # Authentification du dashboard Traefik (htpasswd du vault)
    traefik-auth:
      basicAuth:
        users:
          - '{{ traefik_auth }}'
        removeHeader: true

{% if 'seedbox' in enabled_services %}
    # Mot de passe unique de la seedbox (htpasswd du vault)
    seedbox-auth:
      basicAuth:
        users:
          - '{{ seedbox_auth }}'
        removeHeader: true

{% endif %}
    # Compression (utilisée par les applications)
    compression:
      compress:
        excludedContentTypes:
          - text/event-stream

  routers:
    # Dashboard Traefik
    traefik-https:
      entryPoints:
        - websecure
      rule: "Host(`{{ service_domains.traefik }}`)"
      service: api@internal
      middlewares:
        - traefik-auth
      tls:
        certResolver: "{{ 'letsencrypt' if proxy_enable_letsencrypt else '' }}"
