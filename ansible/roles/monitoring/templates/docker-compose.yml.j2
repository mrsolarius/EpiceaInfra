services:
  prometheus:
    image: prom/prometheus:{{ docker_versions.monitoring.prometheus }}
    container_name: prometheus
    restart: {{ docker_restart_policy }}
    user: root
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
        reservations:
          cpus: '0.2'
          memory: 1G
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=${PROMETHEUS_RETENTION:-15d}'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--web.enable-lifecycle'
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/rules:/etc/prometheus/rules:ro
      - ${MONITORING_PATH}/prometheus:/prometheus
    networks:
      - proxy
      - monitoring
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  alertmanager:
    image: prom/alertmanager:{{ docker_versions.monitoring.alertmanager }}
    container_name: alertmanager
    restart: {{ docker_restart_policy }}
    deploy:
      resources:
        limits:
          cpus: '0.2'
          memory: 256M
        reservations:
          cpus: '0.05'
          memory: 128M
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    # État en mémoire, remis à zéro à chaque redémarrage. Sinon, une alerte résolue
    # pendant un redémarrage reste "déjà notifiée" et sa prochaine occurrence est
    # muette pendant repeat_interval (12h).
    tmpfs:
      - /alertmanager:uid=65534,gid=65534  # Alertmanager tourne en nobody
    networks:
      - monitoring
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9093/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:{{ docker_versions.monitoring.cadvisor }}
    container_name: cadvisor
    restart: {{ docker_restart_policy }}
    privileged: true
    deploy:
      resources:
        limits:
          cpus: '0.2'
          memory: 1gb
        reservations:
          cpus: '0.1'
          memory: 256M
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - monitoring
      - docker-socket
    # cAdvisor n'essaie qu'une fois de joindre Docker : s'il démarre avant le proxy (redémarrage
    # de l'hôte ou de la stack, où depends_on n'est pas respecté), il ne voit plus aucun conteneur
    # et toutes les alertes « conteneur arrêté » partent. On attend donc que Docker réponde.
    entrypoint:
      - sh
      - -c
      - until wget -qO- http://docker-socket-proxy:2375/_ping >/dev/null 2>&1; do sleep 2; done; exec /usr/bin/cadvisor -logtostderr "$$@"
      - cadvisor
    command:
      - '--housekeeping_interval=10s'
      - '--store_container_labels=true'
      - '--whitelisted_container_labels=com.docker.compose.service,com.docker.compose.project'
      - '--docker=http://docker-socket-proxy:2375'
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/healthz"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    depends_on:
      docker-socket-proxy:
        condition: service_healthy

  redis-exporter:
    image: oliver006/redis_exporter:{{ docker_versions.common.redis_exporter }}
    container_name: redis-exporter
    restart: {{ docker_restart_policy }}
    deploy:
      resources:
        limits:
          cpus: '0.1'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 64M
    env_file: .env
    environment:
      REDIS_ADDR: "redis:6379"
      REDIS_EXPORTER_CHECK_KEYS: "*"
      REDIS_EXPORTER_CHECK_SINGLE_KEYS: ""
      REDIS_EXPORTER_INCL_SYSTEM_METRICS: "true"
    networks:
      - monitoring
      - proxy
    # Pas de healthcheck : l'image ne contient aucun outil (ni wget ni shell).
    # Sa disponibilité est suivie par Prometheus (cible "redis-exporter").

  grafana:
    image: grafana/grafana:{{ docker_versions.monitoring.grafana }}
    container_name: grafana
    restart: {{ docker_restart_policy }}
    user: root
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 1G
        reservations:
          cpus: '0.1'
          memory: 512M
    env_file: .env
    volumes:
      - ${MONITORING_PATH}/grafana:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - proxy
      - monitoring
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ docker_proxy_network_name }}"
      - "traefik.http.routers.grafana-https.entrypoints=websecure"
      - "traefik.http.routers.grafana-https.rule=Host(`${GRAFANA_DOMAIN}`)"
      - "traefik.http.routers.grafana-https.service=grafana"
      - "traefik.http.routers.grafana-https.tls=true"
      - "traefik.http.routers.grafana-https.tls.certresolver={{ 'letsencrypt' if proxy_enable_letsencrypt else '' }}"
      - "traefik.http.routers.grafana-https.middlewares=compression@file"
      - "traefik.http.services.grafana.loadbalancer.server.port=3000"

    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    depends_on:
      prometheus:
        condition: service_healthy
      cadvisor:
        condition: service_healthy
      loki:
        condition: service_healthy

  loki:
    image: grafana/loki:{{ docker_versions.monitoring.loki }}
    container_name: loki
    restart: {{ docker_restart_policy }}
    user: root
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 1G
        reservations:
          cpus: '0.1'
          memory: 512M
    command: -config.file=/etc/loki/loki-config.yml
    volumes:
      - ./loki/loki-config.yml:/etc/loki/loki-config.yml:ro
      - ${MONITORING_PATH}/loki:/loki
    networks:
      - monitoring
    # Image distroless depuis la 3.6 (ni shell ni wget) : le binaire se vérifie lui-même (-health)
    healthcheck:
      test: ["CMD", "/usr/bin/loki", "-health"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 30s

  promtail:
    image: grafana/promtail:{{ docker_versions.monitoring.promtail }}
    container_name: promtail
    restart: {{ docker_restart_policy }}
    deploy:
      resources:
        limits:
          cpus: '0.2'
          memory: 512M
        reservations:
          cpus: '0.05'
          memory: 256M
    command: -config.file=/etc/promtail/promtail-config.yml
    volumes:
      - ./promtail/promtail-config.yml:/etc/promtail/promtail-config.yml:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    networks:
      - monitoring
      - docker-socket
    depends_on:
      loki:
        condition: service_healthy
      docker-socket-proxy:
        condition: service_healthy

  docker-socket-proxy:
    image: tecnativa/docker-socket-proxy:{{ docker_versions.common.docker_socket_proxy }}
    container_name: docker-socket-proxy-monitoring
    restart: {{ docker_restart_policy }}
    deploy:
      resources:
        limits:
          cpus: '0.10'
          memory: 64M
        reservations:
          cpus: '0.05'
          memory: 32M
    security_opt:
      - no-new-privileges:true
    networks:
      - docker-socket
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - CONTAINERS=1
      - NETWORKS=1
      - SERVICES=1  # Nécessaire pour le discovery
      - SWARM=0     # Tu n'es pas en Swarm, laisse à 0
      - TASKS=0
      - IMAGES=1    # Permet de voir les versions d'images sur le dashboard
      - VOLUMES=1   # Permet de voir les montages
      - INFO=1      # Permet de voir les infos système (CPU/RAM de l'hôte)
      - POST=0      # <--- IMPORTANT : Laisse à 0 pour empêcher de créer/supprimer
      - LOG_LEVEL=info
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "2375"]
      interval: 10s
      timeout: 5s
      retries: 3

networks:
  proxy:
    external: true
    name: {{ docker_proxy_network_name }}
  monitoring:
    external: true
    name: {{ docker_monitoring_network_name }}
  docker-socket:
    internal: true
