# ========================================
# Redis - Géré par Ansible
# ========================================
# Seuls les réglages différents des valeurs par défaut de Redis sont listés.

# Accès réservé aux réseaux Docker (pas de port publié sur l'hôte), avec mot de passe
bind 0.0.0.0
protected-mode yes

# Persistance : journal AOF en plus des snapshots RDB par défaut
dir /data
appendonly yes
appendfsync everysec

# Sous la limite du conteneur (512M) pour que Redis refuse les écritures
# plutôt que d'être tué par le noyau. noeviction : requis par la file de
# tâches d'Immich (BullMQ), qui ne doit jamais perdre de clés.
maxmemory 400mb
maxmemory-policy noeviction

# Commandes lentes (> 10 ms) visibles dans le slowlog et le monitoring
slowlog-log-slower-than 10000
latency-monitor-threshold 100
