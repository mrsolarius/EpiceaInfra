
# Paths & Network
TZ={{ timezone }}
PUID={{ common_system_user }}
PGID={{ common_system_group }}
SEEDBOX_CONFIG_PATH={{ seedbox_config_path }}
SEEDBOX_MOVIES_PATH={{ storage.media.jellyfin_movies }}
SEEDBOX_SHOWS_PATH={{ storage.media.jellyfin_shows }}
SEEDBOX_MUSIC_PATH={{ storage.media.jellyfin_music }}
SEEDBOX_TORRENTS_PATH={{ storage.media.torrents }}
SEEDBOX_DOMAIN={{ service_domains.seedbox }}
WEBUI_PORT=8080
DEBUG=false

# VPN (identifiants OpenVPN du compte ProtonVPN, suffixe +pmp : port forwarding)
VPN_ENABLED={{ 'yes' if seedbox_vpn_enabled | bool else 'no' }}
VPN_PROV={{ seedbox_vpn_provider }}
VPN_CLIENT={{ seedbox_vpn_client }}
VPN_USER={{ seedbox_vpn_user }}
VPN_PASS={{ seedbox_vpn_pass }}
LAN_NETWORK={{ seedbox_lan_network }}
NAME_SERVERS={{ seedbox_name_servers }}
