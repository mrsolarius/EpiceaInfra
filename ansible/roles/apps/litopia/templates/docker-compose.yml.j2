{% import 'postgres.j2' as pg with context %}
services:
  litopia-front:
    image: ghcr.io/litopiacommunity/litopia-front:{{ docker_versions.litopia.frontend }}
    container_name: litopia-front
    restart: {{ docker_restart_policy }}
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 256M
        reservations:
          cpus: '0.10'
          memory: 128M
    env_file: ./litopia-front.env
    networks:
      - proxy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:4000"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ docker_proxy_network_name }}"
      - "traefik.http.routers.litopia-front.rule=Host(`${LITOPIA_DOMAIN}`) && !PathPrefix(`/api`)"
      - "traefik.http.routers.litopia-front.entrypoints=web"
      - "traefik.http.routers.litopia-front.service=litopia-front"
      - "traefik.http.routers.litopia-front.priority=1"
      - "traefik.http.routers.litopia-front.rule=Host(`${LITOPIA_DOMAIN}`) && !PathPrefix(`/api`)"
      - "traefik.http.routers.litopia-front.entrypoints=websecure"
      - "traefik.http.routers.litopia-front.service=litopia-front"
      - "traefik.http.routers.litopia-front.tls=true"
      - "traefik.http.routers.litopia-front.tls.certresolver={{ 'letsencrypt' if proxy_enable_letsencrypt else '' }}"
      - "traefik.http.routers.litopia-front.priority=1"
      - "traefik.http.services.litopia-front.loadbalancer.server.port=4000"

  litopia-back:
    image: ghcr.io/litopiacommunity/litopia-back:{{ docker_versions.litopia.backend }}
    container_name: litopia-back
    restart: {{ docker_restart_policy }}
    depends_on:
      litopia-db:
        condition: service_healthy
    deploy:
      resources:
        limits:
          cpus: '0.50'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M
    env_file: .env
    networks:
      - default
      - proxy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ docker_proxy_network_name }}"
      - "traefik.http.routers.litopia-back-https.rule=Host(`${LITOPIA_DOMAIN}`) && PathPrefix(`/api`)"
      - "traefik.http.routers.litopia-back-https.entrypoints=websecure"
      - "traefik.http.routers.litopia-back-https.service=litopia-back"
      - "traefik.http.routers.litopia-back-https.tls=true"
      - "traefik.http.routers.litopia-back-https.tls.certresolver={{ 'letsencrypt' if proxy_enable_letsencrypt else '' }}"
      - "traefik.http.routers.litopia-back-https.priority=1000"
      - "traefik.http.services.litopia-back.loadbalancer.server.port=3000"

{{ pg.database('litopia') }}

{{ pg.exporter('litopia') }}

networks:
  default:
  monitoring:
    name: {{ docker_monitoring_network_name }}
    external: true
  proxy:
    name: {{ docker_proxy_network_name }}
    external: true
