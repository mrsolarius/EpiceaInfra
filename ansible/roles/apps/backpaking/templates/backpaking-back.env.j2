# ========================================
# Backpaking backend + PostgreSQL
# ========================================

SPRING_APPLICATION_NAME=backpaking
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://backpaking-db:5432/{{ backpaking_db_database }}
SPRING_DATASOURCE_USERNAME={{ backpaking_db_user }}
SPRING_DATASOURCE_PASSWORD={{ backpaking_db_password }}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/db.changelog-master.yaml

SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=30MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=30MB
SERVER_TOMCAT_MAX_SWALLOW_SIZE=-1
SPRING_SERVLET_MULTIPART_ENABLED=true
SPRING_SERVLET_MULTIPART_FILE_SIZE_THRESHOLD=2KB

APP_UPLOAD_DIR=uploads
APP_WEBP_QUALITY=80
APP_ROOT_URL=https://{{ service_domains.backpaking }}

JWT_SECRET={{ backpaking_jwt_secret }}
JWT_EXPIRATION=2592000000

# PostgreSQL init (used by postgres container)
POSTGRES_DB={{ backpaking_db_database }}
POSTGRES_USER={{ backpaking_db_user }}
POSTGRES_PASSWORD={{ backpaking_db_password }}

# Docker Compose variables
BACKPAKING_DOMAIN={{ service_domains.backpaking }}
BACKPAKING_DB_DATA_PATH={{ storage.databases.backpaking }}
BACKPAKING_FRONT_PORT=4001
BACKPAKING_BACK_PORT=8080

SPRING_SECURITY_DEBUG=true
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG
